# Copy the values you need into the real .env file (BackEnd/.env). Never commit real keys.

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=furniture

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The owner account is created from these on every start-up
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me

# AI room decoration (Google AI Studio key)
GOOGLE_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-3.6-flash

# Google Sign-In: "Web application" OAuth client id from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: extra allowed browser origins (comma separated)
# CORS_ORIGINS=https://my-shop.example.com
